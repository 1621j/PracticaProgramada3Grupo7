@model PracticaProgramada3Grupo7.Models.PartidoPoliticoViewModel

@{
    ViewData["Title"] = "Registrar partido";
}

<div class="form-page">

    <div class="form-card">

        <div class="form-card-header">

            <span class="page-eyebrow">
                Partidos políticos
            </span>

            <h1>Registrar partido</h1>

            <p>
                Ingrese los datos del partido político.
            </p>

        </div>

        <form asp-controller="PartidosPoliticos"
              asp-action="Crear"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger validation-summary">
            </div>

            <div class="form-grid">

                <div class="form-group">

                    <label asp-for="Nombre"></label>

                    <input asp-for="Nombre"
                           class="form-control"
                           maxlength="150"
                           autocomplete="off"
                           placeholder="Nombre del partido" />

                    <span asp-validation-for="Nombre"
                          class="text-danger">
                    </span>

                </div>

                <div class="form-group">

                    <label asp-for="Siglas"></label>

                    <input asp-for="Siglas"
                           class="form-control party-uppercase"
                           maxlength="20"
                           autocomplete="off"
                           placeholder="Ejemplo: PLN" />

                    <small class="form-help">
                        Las siglas se guardarán en mayúscula.
                    </small>

                    <span asp-validation-for="Siglas"
                          class="text-danger">
                    </span>

                </div>

                <div class="form-group form-group-full">

                    <label asp-for="Candidato"></label>

                    <input asp-for="Candidato"
                           class="form-control"
                           maxlength="150"
                           autocomplete="off"
                           placeholder="Nombre completo del candidato" />

                    <span asp-validation-for="Candidato"
                          class="text-danger">
                    </span>

                </div>

                <div class="form-group form-group-full">

                    <label asp-for="Descripcion"></label>

                    <textarea asp-for="Descripcion"
                              class="form-control"
                              maxlength="500"
                              rows="4"
                              placeholder="Descripción opcional del partido">
                    </textarea>

                    <div class="character-counter">
                        Máximo 500 caracteres.
                    </div>

                    <span asp-validation-for="Descripcion"
                          class="text-danger">
                    </span>

                </div>

            </div>

            <div class="form-check app-check">

                <input asp-for="EstaActivo"
                       class="form-check-input" />

                <label asp-for="EstaActivo"
                       class="form-check-label">
                </label>

            </div>

            <div class="form-actions">

                <a asp-controller="PartidosPoliticos"
                   asp-action="Index"
                   class="btn btn-light">
                    Cancelar
                </a>

                <button type="submit"
                        class="btn btn-primary">
                    Guardar partido
                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const siglas = document.getElementById("Siglas");

            if (siglas) {
                siglas.addEventListener("input", function () {
                    this.value = this.value.toUpperCase();
                });
            }
        });
    </script>
}