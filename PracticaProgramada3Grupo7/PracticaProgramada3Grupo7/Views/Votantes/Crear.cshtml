@model PracticaProgramada3Grupo7.Models.VotanteViewModel

@{
    ViewData["Title"] = "Registrar votante";
}

<div class="form-page">

    <div class="form-card">

        <div class="form-card-header">

            <span class="page-eyebrow">
                Votantes
            </span>

            <h1>Registrar votante</h1>

            <p>
                Ingrese la información de la persona.
            </p>

        </div>

        <form asp-controller="Votantes"
              asp-action="Crear"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger validation-summary">
            </div>

            <div class="form-grid">

                <div class="form-group">

                    <label asp-for="Cedula"></label>

                    <input asp-for="Cedula"
                           class="form-control"
                           inputmode="numeric"
                           maxlength="9"
                           autocomplete="off"
                           placeholder="Ejemplo: 101230456" />

                    <small class="form-help">
                        Digite 9 números, sin guiones ni espacios.
                    </small>

                    <span asp-validation-for="Cedula"
                          class="text-danger">
                    </span>

                </div>

                <div class="form-group">

                    <label asp-for="Nombre"></label>

                    <input asp-for="Nombre"
                           class="form-control"
                           maxlength="100"
                           autocomplete="off"
                           placeholder="Ingrese el nombre" />

                    <span asp-validation-for="Nombre"
                          class="text-danger">
                    </span>

                </div>

                <div class="form-group">

                    <label asp-for="PrimerApellido"></label>

                    <input asp-for="PrimerApellido"
                           class="form-control"
                           maxlength="100"
                           autocomplete="off"
                           placeholder="Ingrese el primer apellido" />

                    <span asp-validation-for="PrimerApellido"
                          class="text-danger">
                    </span>

                </div>

                <div class="form-group">

                    <label asp-for="SegundoApellido"></label>

                    <input asp-for="SegundoApellido"
                           class="form-control"
                           maxlength="100"
                           autocomplete="off"
                           placeholder="Ingrese el segundo apellido" />

                    <span asp-validation-for="SegundoApellido"
                          class="text-danger">
                    </span>

                </div>

            </div>

            <div class="form-check app-check">

                <input asp-for="EstaActivo"
                       class="form-check-input" />

                <label asp-for="EstaActivo"
                       class="form-check-label">
                </label>

            </div>

            <div class="form-actions">

                <a asp-controller="Votantes"
                   asp-action="Index"
                   class="btn btn-light">
                    Cancelar
                </a>

                <button type="submit"
                        class="btn btn-primary">
                    Guardar votante
                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const cedula = document.getElementById("Cedula");

            if (cedula) {
                cedula.addEventListener("input", function () {
                    this.value = this.value.replace(/\D/g, "").slice(0, 9);
                });
            }
        });
    </script>
}
